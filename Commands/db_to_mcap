#!/usr/bin/env -S uv run --project /Users/jeffhykin/repos/dimos --with mcap --with rosbags python
"""Convert a dimos memory2 .db recording into a ROS2-compatible .mcap file."""

import argparse
import heapq
import sys
import time
from pathlib import Path

import numpy as np
from mcap.writer import Writer
from rosbags.typesys import Stores, get_typestore

from dimos.memory2.store.sqlite import SqliteStore

typestore = get_typestore(Stores.ROS2_HUMBLE)

Time = typestore.types["builtin_interfaces/msg/Time"]
Header = typestore.types["std_msgs/msg/Header"]
Vector3 = typestore.types["geometry_msgs/msg/Vector3"]
Point = typestore.types["geometry_msgs/msg/Point"]
Quaternion = typestore.types["geometry_msgs/msg/Quaternion"]
Pose = typestore.types["geometry_msgs/msg/Pose"]
PoseWithCovariance = typestore.types["geometry_msgs/msg/PoseWithCovariance"]
Twist = typestore.types["geometry_msgs/msg/Twist"]
TwistWithCovariance = typestore.types["geometry_msgs/msg/TwistWithCovariance"]
Transform = typestore.types["geometry_msgs/msg/Transform"]
TransformStamped = typestore.types["geometry_msgs/msg/TransformStamped"]
TFMessage = typestore.types["tf2_msgs/msg/TFMessage"]
Image = typestore.types["sensor_msgs/msg/Image"]
CameraInfo = typestore.types["sensor_msgs/msg/CameraInfo"]
RegionOfInterest = typestore.types["sensor_msgs/msg/RegionOfInterest"]
Imu = typestore.types["sensor_msgs/msg/Imu"]
PointCloud2 = typestore.types["sensor_msgs/msg/PointCloud2"]
PointField = typestore.types["sensor_msgs/msg/PointField"]
Odometry = typestore.types["nav_msgs/msg/Odometry"]

# dimos ImageFormat name -> (ROS encoding, numpy dtype, channels)
IMAGE_ENCODINGS = {
    "RGB": ("rgb8", np.uint8, 3),
    "BGR": ("bgr8", np.uint8, 3),
    "RGBA": ("rgba8", np.uint8, 4),
    "BGRA": ("bgra8", np.uint8, 4),
    "GRAY": ("mono8", np.uint8, 1),
    "GRAY16": ("mono16", np.uint16, 1),
    "DEPTH16": ("16UC1", np.uint16, 1),
    "DEPTH": ("32FC1", np.float32, 1),
}


def ros_time(seconds):
    nanoseconds = int(round(seconds * 1e9))
    return Time(sec=nanoseconds // 1_000_000_000, nanosec=nanoseconds % 1_000_000_000)


def header(seconds, frame_id):
    return Header(stamp=ros_time(seconds), frame_id=frame_id or "")


def covariance36(source):
    if source is None:
        return np.zeros(36, dtype=np.float64)
    return np.asarray(source, dtype=np.float64).reshape(36)


def covariance9(source):
    if source is None:
        return np.zeros(9, dtype=np.float64)
    return np.asarray(source, dtype=np.float64).reshape(9)


def to_pose(dimos_pose):
    position = dimos_pose.position
    orientation = dimos_pose.orientation
    return Pose(
        position=Point(x=float(position.x), y=float(position.y), z=float(position.z)),
        orientation=Quaternion(
            x=float(orientation.x), y=float(orientation.y), z=float(orientation.z), w=float(orientation.w)
        ),
    )


def convert_image(message, seconds):
    encoding, dtype, channels = IMAGE_ENCODINGS[message.format.name]
    pixels = np.ascontiguousarray(message.data, dtype=dtype)
    return Image(
        header=header(seconds, message.frame_id),
        height=int(message.height),
        width=int(message.width),
        encoding=encoding,
        is_bigendian=0,
        step=int(message.width) * channels * dtype().itemsize,
        data=pixels.reshape(-1).view(np.uint8),
    )


def convert_camera_info(message, seconds):
    return CameraInfo(
        header=header(seconds, message.frame_id),
        height=int(message.height),
        width=int(message.width),
        distortion_model=message.distortion_model or "plumb_bob",
        d=np.asarray(message.D, dtype=np.float64),
        k=np.asarray(message.K, dtype=np.float64).reshape(9),
        r=np.asarray(message.R, dtype=np.float64).reshape(9),
        p=np.asarray(message.P, dtype=np.float64).reshape(12),
        binning_x=int(message.binning_x),
        binning_y=int(message.binning_y),
        roi=RegionOfInterest(x_offset=0, y_offset=0, height=0, width=0, do_rectify=False),
    )


def convert_imu(message, seconds):
    orientation = message.orientation
    angular = message.angular_velocity
    linear = message.linear_acceleration
    return Imu(
        header=header(seconds, message.frame_id),
        orientation=Quaternion(
            x=float(orientation.x), y=float(orientation.y), z=float(orientation.z), w=float(orientation.w)
        ),
        orientation_covariance=covariance9(message.orientation_covariance),
        angular_velocity=Vector3(x=float(angular.x), y=float(angular.y), z=float(angular.z)),
        angular_velocity_covariance=covariance9(getattr(message, "angular_velocity_covariance", None)),
        linear_acceleration=Vector3(x=float(linear.x), y=float(linear.y), z=float(linear.z)),
        linear_acceleration_covariance=covariance9(getattr(message, "linear_acceleration_covariance", None)),
    )


POINT_FIELDS = [
    PointField(name="x", offset=0, datatype=7, count=1),
    PointField(name="y", offset=4, datatype=7, count=1),
    PointField(name="z", offset=8, datatype=7, count=1),
    PointField(name="intensity", offset=12, datatype=7, count=1),
]


def convert_pointcloud(message, seconds):
    points = message.points_f32()
    intensities = message.intensities_f32()
    count = points.shape[0]
    packed = np.zeros((count, 4), dtype=np.float32)
    packed[:, :3] = points
    if intensities is not None and intensities.shape[0] == count:
        packed[:, 3] = intensities
    return PointCloud2(
        header=header(seconds, message.frame_id),
        height=1,
        width=count,
        fields=POINT_FIELDS,
        is_bigendian=False,
        point_step=16,
        row_step=16 * count,
        data=packed.reshape(-1).view(np.uint8),
        is_dense=True,
    )


def convert_odometry(message, seconds):
    linear = message.twist.linear
    angular = message.twist.angular
    return Odometry(
        header=header(seconds, message.frame_id),
        child_frame_id=message.child_frame_id or "",
        pose=PoseWithCovariance(pose=to_pose(message.pose), covariance=covariance36(message.pose.covariance)),
        twist=TwistWithCovariance(
            twist=Twist(
                linear=Vector3(x=float(linear.x), y=float(linear.y), z=float(linear.z)),
                angular=Vector3(x=float(angular.x), y=float(angular.y), z=float(angular.z)),
            ),
            covariance=covariance36(message.twist.covariance),
        ),
    )


def convert_tf(message, seconds):
    transforms = []
    for entry in message.transforms:
        translation = entry.translation
        rotation = entry.rotation
        transforms.append(
            TransformStamped(
                header=header(entry.ts or seconds, entry.frame_id),
                child_frame_id=entry.child_frame_id or "",
                transform=Transform(
                    translation=Vector3(
                        x=float(translation.x), y=float(translation.y), z=float(translation.z)
                    ),
                    rotation=Quaternion(
                        x=float(rotation.x), y=float(rotation.y), z=float(rotation.z), w=float(rotation.w)
                    ),
                ),
            )
        )
    return TFMessage(transforms=transforms)


CONVERTERS = {
    "Image": ("sensor_msgs/msg/Image", convert_image),
    "CameraInfo": ("sensor_msgs/msg/CameraInfo", convert_camera_info),
    "Imu": ("sensor_msgs/msg/Imu", convert_imu),
    "PointCloud2": ("sensor_msgs/msg/PointCloud2", convert_pointcloud),
    "Odometry": ("nav_msgs/msg/Odometry", convert_odometry),
    "TFMessage": ("tf2_msgs/msg/TFMessage", convert_tf),
}


def stream_events(store, stream_name, limit):
    for index, observation in enumerate(store.streams[stream_name]):
        if limit and index >= limit:
            return
        yield observation.ts, stream_name, observation


def main():
    parser = argparse.ArgumentParser(description="Convert a dimos memory2 .db recording to a ROS2 .mcap file")
    parser.add_argument("database", help="input recording .db")
    parser.add_argument("-o", "--out", help="output .mcap (default: <input>.mcap)")
    parser.add_argument("--limit", type=int, default=0, help="only convert the first N messages per stream")
    parser.add_argument("--streams", help="comma-separated subset of stream names")
    arguments = parser.parse_args()

    database_path = Path(arguments.database).expanduser()
    output_path = Path(arguments.out).expanduser() if arguments.out else database_path.with_suffix(".mcap")

    store = SqliteStore(path=str(database_path), must_exist=True)
    stream_names = arguments.streams.split(",") if arguments.streams else store.list_streams()

    with open(output_path, "wb") as output_file:
        writer = Writer(output_file)
        writer.start(profile="ros2", library="db_to_mcap")

        channels = {}
        skipped = []
        for stream_name in stream_names:
            payload_type = type(next(iter(store.streams[stream_name])).data).__name__
            if payload_type not in CONVERTERS:
                skipped.append(f"{stream_name} ({payload_type})")
                continue
            ros_type, converter = CONVERTERS[payload_type]
            definition, _ = typestore.generate_msgdef(ros_type)
            schema_id = writer.register_schema(name=ros_type, encoding="ros2msg", data=definition.encode())
            channel_id = writer.register_channel(
                topic="/" + stream_name, message_encoding="cdr", schema_id=schema_id
            )
            channels[stream_name] = (channel_id, converter, ros_type)
            print(f"  {stream_name:34s} -> /{stream_name:34s} {ros_type}", flush=True)

        for entry in skipped:
            print(f"  SKIPPED (no ROS mapping): {entry}", file=sys.stderr, flush=True)

        merged = heapq.merge(*(stream_events(store, name, arguments.limit) for name in channels))

        written = 0
        failed = 0
        started_at = time.monotonic()
        for seconds, stream_name, observation in merged:
            channel_id, converter, ros_type = channels[stream_name]
            try:
                ros_message = converter(observation.data, seconds)
                payload = typestore.serialize_cdr(ros_message, ros_type)
            except Exception as error:
                failed += 1
                if failed <= 5:
                    print(f"  ! {stream_name} @ {seconds}: {error}", file=sys.stderr, flush=True)
                continue
            nanoseconds = int(round(seconds * 1e9))
            writer.add_message(
                channel_id=channel_id, log_time=nanoseconds, publish_time=nanoseconds, data=payload
            )
            written += 1
            if written % 1000 == 0:
                elapsed = time.monotonic() - started_at
                print(f"  {written} messages ({written / elapsed:.0f}/s)", flush=True)

        writer.finish()

    size_gb = output_path.stat().st_size / 1e9
    print(f"wrote {written} messages ({failed} failed) -> {output_path} [{size_gb:.2f} GB]")


if __name__ == "__main__":
    main()
