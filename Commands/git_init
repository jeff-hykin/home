#!/usr/bin/env bash

git init

# write the standard .gitignore (shared template; see .default_gitignore next to this script)
__git_init_dir="$(cd "$(dirname "$0")" && pwd)"
if [ -f "$__git_init_dir/.default_gitignore" ]
then
    cat "$__git_init_dir/.default_gitignore" > .gitignore
else
    echo "warning: $__git_init_dir/.default_gitignore not found; creating empty .gitignore" 1>&2
    : > .gitignore
fi

git add .gitignore
git commit -m "gitignore"
git add -A
git commit -m "init"
