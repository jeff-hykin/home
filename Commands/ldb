#!/usr/bin/env -S deno run --allow-env --allow-read
// ldb — list the 10 most recent memory2 recording .db files across dimos clones.
// Searches ~/repos/dimos*/recordings/ and ~/.local/state/dimos/recordings/.
// No external deps (esm.sh-transpiled deps silently break under cbg — see lsd).

const home = Deno.env.get("HOME")

const roots = []
for await (const entry of Deno.readDir(`${home}/repos`)) {
    if (entry.isDirectory && /^dimos/.test(entry.name)) {
        roots.push(`${home}/repos/${entry.name}/recordings`)
    }
}
roots.push(`${home}/.local/state/dimos/recordings`)

async function* walk(dir, depth) {
    // Deno.readDir defers errors to iteration time, so the loop sits in the try.
    try {
        for await (const entry of Deno.readDir(dir)) {
            const path = `${dir}/${entry.name}`
            if (entry.isDirectory && depth > 0) {
                yield* walk(path, depth - 1)
            } else if (entry.isFile && entry.name.endsWith(".db")) {
                yield path
            }
        }
    } catch {
        // unreadable or missing dir — skip
    }
}

const dbs = []
for (const root of roots) {
    for await (const path of walk(root, 3)) {
        const stat = await Deno.stat(path)
        dbs.push({ path, mtime: stat.mtime?.getTime() ?? 0, size: stat.size })
    }
}

dbs.sort((a, b) => b.mtime - a.mtime)

function human(bytes) {
    if (bytes >= 1e9) {
        return (bytes / 1e9).toFixed(1) + "G"
    }
    if (bytes >= 1e6) {
        return (bytes / 1e6).toFixed(0) + "M"
    }
    return (bytes / 1e3).toFixed(0) + "K"
}

function stamp(ms) {
    const d = new Date(ms)
    const pad = (n) => String(n).padStart(2, "0")
    return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}`
}

for (const db of dbs.slice(0, 10)) {
    console.log(`${stamp(db.mtime)}  ${human(db.size).padStart(6)}  ${db.path}`)
}
if (dbs.length === 0) {
    console.error("no .db files found under dimos recordings dirs")
}
