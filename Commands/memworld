#!/bin/bash
# Serve a recording as the VR/phone memory world: walk the map, scrub the
# timeline, ask "where did I see a traffic cone".
#
#   memworld                     # the sf_office1_2 recording
#   memworld path/to/other.db    # or .mcap
#   memworld --stop              # shut the server down
#
# ONE server at a time, whatever port it is on: starting a recording stops the one
# already running even if the new one is going to a different --server-port, because
# this script owns a single log and a single lock. Two at once is not a thing it does.
#
# The first run on a new recording builds a SigLIP image index and the voxel
# replay streams into it (into <name>.derived.db for a read-only .mcap), which
# takes a few minutes; after that it starts in seconds.
set -euo pipefail

repo="${MEMWORLD_REPO:-$HOME/repos/_memworld_wt}"
venv="${MEMWORLD_VENV:-$HOME/repos/dimos/.venv}"
recording="${1:-$HOME/datasets/d455/sf_office1_2/main.db}"
log=/tmp/memworld.log

if [ ! -d "$repo/dimos" ]; then
    echo "memworld: no dimos checkout at $repo. Set MEMWORLD_REPO." >&2
    exit 1
fi
# Worktrees have no venv of their own, so the main clone's is used with a
# PYTHONPATH override that puts this branch's dimos/ first.
source "$venv/bin/activate"

# `bin/dimos`, not just the words: `pkill -f` kills anything whose argv CONTAINS the
# pattern, and the thing most likely to have these words in its argv is a command
# someone is running ABOUT memworld -- a `watch pgrep -f 'dimos run memory-world-module'`
# left in another pane would otherwise be killed by every stop, and would wedge every
# start. The real server always runs .venv/bin/dimos; only `python -m dimos` would miss.
# `pgrep -f` takes an extended regex, and this has to match every way the module gets
# started, not just the way this script starts it:
#   memory-world-agent  is the blueprint the module's own README tells you to run, and it
#                       serves the SAME module on the SAME default 8443.
#   dimos --replay run  global options sit between `dimos` and `run`, and
#   run --config x BP    run's own options sit between `run` and the blueprint.
# Missing either is not a near miss. `--stop` prints "stopped" over a server that is still
# serving, and the next launch then binds nothing, gets 200 from the OLD server -- the
# probe below cannot tell them apart -- and prints its URLs over the previous recording's
# world. That failure is already written down in module.py's `start()`, seen in a live log.
# ...and ENDING there: without the trailing anchor this also matched
# `memory-world-agent-backup`, and it matched the quoted pattern inside a
# `watch pgrep -f '.../dimos run memory-world-module'` left in another pane -- the
# diagnostic command about memworld being the likeliest thing to carry these words.
pattern='bin/dimos( [^ ]+)* run( [^ ]+)* memory-world-(module|agent)( |$)'

# Which processes are actually this server. `pgrep -f` matches ARGV, and by the time the
# kernel sees it the quotes are gone -- so `watch pgrep -f '.../dimos run memory-world-module'`
# left in another pane has an argv ending exactly where a real launch's does, and NO pattern
# can tell the two apart. A reviewer proved that against the anchor I had added believing it
# did: with no server running at all, `--stop` printed "stopped" and killed the diagnostic.
# The PROCESS can be told apart, though: the real one is python running dimos.
server_pids() {
    out=$(pgrep -f "$pattern" 2>/dev/null)
    if [ $? -gt 1 ]; then return 2; fi   # pgrep itself failed: not "no match"
    for candidate in $out; do
        comm=$(ps -o comm= -p "$candidate" 2>/dev/null)
        rc=$?
        # 1 is "no such process" -- the candidate died between pgrep and here, and dropping
        # it is right. Anything higher is `ps` itself failing or missing, and there is no
        # safe guess: excluding the candidate hides a live server, and INCLUDING it (which
        # is what this did) kills whatever the pattern matched -- a `watch pgrep` in another
        # pane -- on a machine that cannot say what it is. Say we cannot tell instead, which
        # every caller already knows how to report.
        if [ "$rc" -gt 1 ]; then
            return 2
        fi
        case "$comm" in
            *[Pp]ython*|*[Pp]ypy*) printf '%s ' "$candidate" ;;
        esac
    done
    return 0
}

# The port a running server was told to serve, read from its own argv rather than
# assumed. `--stop` used to ask the DEFAULT port about a server started on another one,
# which is how it announced an orphaned worker and named the live demo's pid.
port_of_pid() {
    args=$(ps -o args= -p "$1" 2>/dev/null) || return 1
    previous=""
    found=""
    for word in $args; do
        # The LAST one, because that is the one dimos uses, and only a word that starts
        # with `--`: matching `server-port=` anywhere in a word made
        # `--store-path /data/server-port=abc/main.db` answer "abc/main.db".
        case "$word" in
            --*server[-_]port=*) found=${word#*=} ;;
        esac
        case "$previous" in
            --*server[-_]port) found=$word ;;
        esac
        previous=$word
    done
    if [ -n "$found" ]; then printf '%s' "$found"; return 0; fi
    return 1
}

# 0 = gone, 1 = still there, 2 = cannot tell. The difference matters: treating
# "cannot tell" as "gone" is how a stop that did nothing reports success.
server_state() {
    pids=$(server_pids) || return 2
    if [ -n "$pids" ]; then return 1; fi
    return 0
}

stop_server() {
    # Only this module. `dimos stop` is global — it kills every dimos module on
    # the machine, including other people's and other sessions' blueprints.
    pids=$(server_pids 2>/dev/null) || true
    if [ -n "$pids" ]; then kill $pids 2>/dev/null || true; fi
    # Wait for it to GO, rather than sleeping a guess. A flat `sleep 2` expires while
    # the dying process still holds block-buffered stdout, and a truncating redirect
    # then leaves a megabyte of NULs between a dead run's tail and the live one's output.
    # Against the CLOCK, not a count of iterations: 675 x `sleep 0.2` is 135 s of requested
    # sleep, but each turn also forks, and macOS stretches short sleeps -- measured end to
    # end it took 229 s to say "135s". Budget 135 s because that is what the module can
    # legitimately need: stop() spends join(3) + two join(60) + a 5 s store-lock acquire,
    # and the world-cache builds it waits on do not check _stopping. Measured on the 59 GB
    # recording with the server idle: gone in 3.34 s, so this is a ceiling, not a wait.
    started=$(date +%s)
    deadline=$((started + 135))
    told=""
    while :; do
        st=0; server_state || st=$?
        if [ "$st" -eq 0 ]; then
            if [ -n "$told" ]; then echo; fi
            return 0
        fi
        if [ "$st" -eq 2 ]; then return 2; fi   # cannot tell: say so rather than guess
        now=$(date +%s)
        if [ "$now" -ge "$deadline" ]; then break; fi
        if [ -z "$told" ] && [ $((now - started)) -ge 5 ]; then
            told=$now
            printf 'memworld: waiting for the old server to finish shutting down'
        fi
        if [ -n "$told" ] && [ "$now" -gt "$told" ]; then
            told=$now
            printf .
        fi
        sleep 0.2
    done
    if [ -n "$told" ]; then echo; fi
    return 1
}

# lsof NAMES the holder, but bash can ask the port on its own, so a machine without
# lsof still gets the guard rather than silently skipping it.
port_is_taken() {
    if command -v lsof >/dev/null 2>&1; then
        lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1
        return $?
    fi
    # The connect runs in a SUBSHELL, so its fd 3 dies with it and there is nothing here
    # to close. The `exec 3<&- 3>&- 2>/dev/null` that used to sit here closed nothing and
    # did something else entirely: `exec` with no command makes its redirections
    # permanent, so it pointed THIS SCRIPT's stderr at /dev/null for the rest of the run.
    # Every diagnostic below -- the orphaned-worker report, the reason for a refusal --
    # vanished, and the launcher exited 1 in silence. It never fired here because lsof is
    # always present on this machine, which is exactly why it survived nine rounds.
    if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
        return 0
    fi
    return 1
}
lock=/tmp/memworld.lock

# One launcher at a time -- BEST EFFORT, and deliberately so. A mkdir lock that also
# has to recover from an abandoned one cannot be made airtight in shell: a reviewer
# walked three launchers through an interleaving where one moves another's fresh lock
# aside and a third claims the vacated name, leaving two that believe they hold it.
# That is survivable, but NOT for the reason first written here. The log being ROTATED
# rather than truncated does hold: a second writer cannot hole the first's file. The
# other half -- "the port is checked before launching, so the loser refuses" -- was
# false, and a reviewer said so: stop_server_or_die runs BEFORE the port check, so the
# loser does not refuse, it kills the winner and binds in its place. The port guard only
# catches a holder the process pattern cannot SEE, which is the orphaned worker it was
# added for; a second launcher's server is exactly what the pattern can see and kill.
# What that race actually costs is a launcher reporting success over the other one's
# server, and the probe below now checks `$launched` for precisely that.
# Do not add a timing heuristic here to chase the last interleaving
# -- it would break the common recovery, which is a lock left by a run killed seconds ago.
lock_held=""

release_lock() {
    if [ -z "$lock_held" ]; then return 0; fi
    lock_held=""            # never delete a lock a later launcher now owns
    rm -f "$lock/pid"
    rmdir "$lock" 2>/dev/null || true
}

# Two launchers can read the same dead holder pid and both decide to clear the lock: the
# first clears it and takes a NEW one, and the second's delete then removes THAT, leaving
# both of them believing they hold it. So nothing is deleted on the strength of a pid read
# earlier: the directory is MOVED first -- rename(2) is atomic, so exactly one racer gets
# it -- and only then inspected, so what gets thrown away is always the thing that was
# just examined. A holder that turns out to be alive is put straight back.
steal_lock() {
    dead="$lock.dead.$$"
    mv "$lock" "$dead" 2>/dev/null || return 1
    owner=$(cat "$dead/pid" 2>/dev/null || true)
    if [ -n "$owner" ] && kill -0 "$owner" 2>/dev/null; then
        # Alive after all, so give it back -- but NEVER with `mv "$dead" "$lock"`.
        # Moving a directory onto a name another launcher has since created does not
        # fail, it NESTS the old lock inside the new one, and then both of them believe
        # they hold it. Claim the name atomically or drop our copy and lose the race.
        if mkdir "$lock" 2>/dev/null; then
            mv "$dead/pid" "$lock/pid" 2>/dev/null || true
        fi
        rm -rf "$dead"
        return 1
    fi
    rm -rf "$dead"
}

take_lock() {
    holder=""
    for attempt in $(seq 1 8); do
        if mkdir "$lock" 2>/dev/null; then
            echo $$ > "$lock/pid"
            lock_held=1
            # A handler that does not exit RESUMES the interrupted loop, so trapping INT
            # here is what stops Ctrl-C from working: the launcher would free its lock and
            # carry on, letting a second one truncate the log beside it. The cleanup goes
            # on EXIT alone -- which a signal reaches through these two, each of which
            # actually exits, with the shell's own status for that signal.
            trap release_lock EXIT
            trap 'exit 130' INT
            trap 'exit 143' TERM
            return 0
        fi
        holder=$(cat "$lock/pid" 2>/dev/null || true)
        if [ -n "$holder" ]; then
            if kill -0 "$holder" 2>/dev/null; then
                break            # a live launcher owns it
            fi
            steal_lock || true   # it died without cleaning up; a refusal just means retry
        elif [ "$attempt" -ge 4 ]; then
            # No pid after a second. Either someone was killed in the microseconds
            # between mkdir and the write, or a stray directory is sitting there.
            # Stealing a lock with no owner is safe; refusing to would wedge every
            # future run with no way out but `rm -rf` by hand.
            steal_lock || true   # `return 1` here is normal: another racer won
        else
            sleep 0.3            # holder may be mid-mkdir; give it a moment
        fi
    done
    echo "memworld: another memworld is starting or stopping (pid ${holder:-?}, lock $lock)" >&2
    exit 1
}

# Refuse to report a stop that did not happen, and never truncate the log or launch
# beside a server that is still up.
stop_server_or_die() {
    stop_server && return 0
    case $? in
        2) echo "memworld: cannot tell whether a server is running (pgrep or ps failed)" >&2 ;;
        *) echo "memworld: a server is still running after 135s, so $log is being left alone." >&2
           echo "memworld: if you are sure it is wedged, kill its whole process GROUP --" >&2
           echo "memworld:   kill -TERM -\$(ps -o pgid= -p $(server_pids | awk '{print $1}') | tr -d ' ')" >&2
           echo "memworld: a plain kill -9 of the supervisor orphans the worker holding the port." >&2 ;;
    esac
    exit 1
}

# The ROUTE matters as much as the port: --client-route moves the viewer, and probing
# /memory_world then gets a 404 from a perfectly healthy server -- which `curl -f` now
# correctly refuses, turning a working launch into "did not answer in 4 minutes".
field_of() {   # the canonical field this argument sets, or nothing
    name=${1#--}
    name=${name%%=*}
    name=$(printf '%s' "$name" | tr '_' '-')
    name=${name#modules.}
    name=${name#memoryworldmodule.}
    case "$name" in
        server-port|client-route) printf '%s' "$name" ;;
    esac
}
port=8443
port_explicit=""      # did anyone actually SAY a port, or is 8443 just the default?
if [ -n "${MEMORYWORLDMODULE__SERVER_PORT:-}" ]; then
    port=$MEMORYWORLDMODULE__SERVER_PORT
    port_explicit=env
fi
route=${MEMORYWORLDMODULE__CLIENT_ROUTE:-/memory_world}
i=1
while [ $((i += 1)) -le $# ]; do
    arg="${!i}"
    field=$(field_of "$arg")
    if [ -z "$field" ]; then continue; fi
    case "$arg" in
        *=*) value="${arg#*=}" ;;
        *)
            next=$((i + 1))
            if [ "$next" -gt "$#" ]; then
                echo "memworld: $arg needs a value" >&2
                exit 1
            fi
            value="${!next}"
            ;;
    esac
    case "$field" in
        server-port) port="$value"; port_explicit=flag ;;
        client-route) route="$value" ;;
    esac
done
# A --config can set the port too, and it never reaches argv. Injecting the DEFAULT over
# it would silently move the server off the port the file asked for, so when a config is
# in play and nobody has named a port, say nothing and probe the default -- which fails
# loudly if the config chose otherwise, rather than quietly serving the wrong one.
config_given=""
i=1
while [ $((i += 1)) -le $# ]; do
    case "${!i}" in --config|--config=*) config_given=yes ;; esac
done
case "$route" in /*) ;; *) route="/$route" ;; esac

if [ "$recording" = "--stop" ]; then
    take_lock
    # Ask the server we are about to kill which port it was serving, instead of assuming
    # the default. A server on 19443 was stopped correctly and then the DEFAULT 8443 was
    # reported as its orphaned worker -- naming, on this machine, the live demo's pid,
    # under a message that tells the operator to kill it.
    running=$(server_pids 2>/dev/null) || true
    port_known=""
    if [ -n "${MEMORYWORLDMODULE__SERVER_PORT:-}" ]; then port_known=env; fi
    i=1
while [ $((i += 1)) -le $# ]; do
        case "${!i}" in --*server[-_]port*) port_known=flag ;; esac
    done
    for pid in $running; do
        if found=$(port_of_pid "$pid"); then
            port=$found
            port_known=argv
            break
        fi
    done
    stop_server_or_die
    # The same question the launch path asks. `stop_server_or_die`'s own header says it
    # refuses to report a stop that did not happen -- but it only ever consulted the
    # process pattern, which cannot see the forkserver worker that holds the socket, so
    # `--stop` said "stopped" over a port that was still serving. Measured: supervisor
    # killed with -9, worker still listening, exit 0 and "stopped".
    # Only when there was one of ours to stop AND we know which port it was on. dimos
    # also takes the port from the environment and from --config, neither of which
    # reaches argv, and this script reads MEMORYWORLDMODULE__SERVER_PORT itself; launches
    # from here now forward the resolved port explicitly so argv always carries it, but a
    # server started another way may still not say. Guessing the default is how this
    # printed "kill those pids" at the live demo's listener.
    if [ -n "$running" ] && [ -n "$port_known" ] && port_is_taken; then
        echo "memworld: the supervisor is gone but port $port is still being served:" >&2
        if command -v lsof >/dev/null 2>&1; then lsof -nP -iTCP:"$port" -sTCP:LISTEN >&2; fi
        echo "memworld: an orphaned worker outlives a supervisor killed with -9." >&2
        exit 1
    fi
    echo "memworld: stopped"
    exit 0
fi
if [ ! -f "$recording" ]; then
    echo "memworld: no recording at $recording" >&2
    exit 1
fi
# That check used YOUR directory; `cd "$repo"` below moves it. A relative argument -- which
# the usage line advertises -- would then be forwarded unchanged and resolved somewhere else,
# after the old server had already been stopped for it.
case "$recording" in
    /*) ;;
    *) recording="$PWD/$recording" ;;
esac

# The port the module will actually serve on: "${@:2}" can override it, and probing
# 8443 then waits on whatever is already there -- or on nothing, for two minutes.
# Parsed BEFORE anything destructive: a bad flag must not cost the operator the
# server that is currently up, and `--server-port` with no value would abort on
# ${!next} after the running demo had already been killed and replaced.
# dimos accepts seven spellings of this one option -- it maps `-` to `_`, and registers a
# `modules.<instance>.<field>` form as well -- and reading only three of them meant the
# server came up on 9443 while this script probed 8443 and reported, after four minutes,
# that a perfectly healthy server had never answered.
case "$port" in
    ''|*[!0-9]*) echo "memworld: server port must be a number, got '$port'" >&2; exit 1 ;;
esac
# Digits first, and few enough of them to compare: `[ 999999999999999999999999 -lt 1 ]`
# does not return false, it FAILS with "integer expression expected", so neither half of
# the range test below is ever true and the absurd port reaches the launch.
if [ ${#port} -gt 5 ]; then
    echo "memworld: server port out of range: $port" >&2
    exit 1
fi
if [ "$port" -lt 1 ] || [ "$port" -gt 65535 ]; then
    echo "memworld: server port out of range: $port" >&2
    exit 1
fi

take_lock
stop_server_or_die
cd "$repo"
export PYTHONPATH="$repo"
# No stream flags: the module names them from the recording's message types,
# so this works on someone else's robot too. Pass extra flags to override.
# --transport lcm keeps this off the zenoh bus, so it starts even when another
# session's blueprint holds the Coordinator there, and never disturbs it.
# Hyperspace answers need SigLIP2 so400m; a local snapshot avoids the HF download.
hyperspace_model="${MEMWORLD_SIGLIP2:-$HOME/models/siglip2-so400m-patch16-384}"
extra=()
if [ -d "$hyperspace_model" ]; then
    extra+=(--memoryworldmodule.hyperspace-model-name "$hyperspace_model")
fi
# The stop above can only see the SUPERVISOR. Measured with lsof on the live demo, the
# process holding the port is a forkserver GRANDCHILD whose argv this pattern cannot
# match. A clean SIGTERM sweeps it by DIMOS_RUN_ID, but a `kill -9` -- which this script
# itself used to suggest -- orphans it, and then the stop looks clean, the new server
# fails to bind, and the probe below is answered by the OLD one. So ask the port itself,
# which is the only thing that knows.
if port_is_taken; then
    echo "memworld: the stop looked clean but something still holds port $port:" >&2
    if command -v lsof >/dev/null 2>&1; then
        lsof -nP -iTCP:"$port" -sTCP:LISTEN >&2
    else
        echo "memworld:   (install lsof to be told which process)" >&2
    fi
    echo "memworld: usually an orphaned worker of a server killed with -9. Kill those pids" >&2
    echo "memworld: and run this again; $log has been left alone." >&2
    exit 1
fi

# Rotate rather than truncate. The process whose argv says `dimos run memory-world-module`
# is a SUPERVISOR: measured with lsof on the live demo, the `:8443` listener and four of the
# five holders of this log were forkserver workers the pattern cannot see, all sharing one
# file offset. The ordinary stop is clean, because dimos's SIGTERM handler sweeps them by
# DIMOS_RUN_ID before the main exits -- but a `kill -9`, which the message above suggests,
# leaves them writing for up to 3.5 s while server_state says "gone" in 0.2 s. Truncating
# under them is what puts a hole of NULs in the log (4218 bytes of it, in two seconds, in a
# faithful reproduction). A survivor keeps writing into the rotated file; this one starts empty.
rm -f "$log.prev"
mv "$log" "$log.prev" 2>/dev/null || true

nohup dimos run memory-world-module \
    --g.rerun-open none \
    --transport lcm \
    --memoryworldmodule.store-path "$recording" \
    --memoryworldmodule.image-index-stride 5 \
    ${port_explicit:+--memoryworldmodule.server-port "$port"} \
    ${extra[@]+"${extra[@]}"} \
    "${@:2}" \
    > "$log" 2>&1 &
launched=$!

# Hold the lock just long enough for that child to become visible to pgrep -- `nohup ... &`
# returns before the exec, and a launcher that stopped at that instant would be told "no
# server" and truncate $log underneath this one. Then release: holding it through the
# readiness probe below would lock the operator out of `memworld --stop`, the very command
# this script prints on success, for up to four minutes.
for _ in $(seq 1 600); do
    if pgrep -f "$pattern" >/dev/null 2>&1; then break; fi
    # Or until it is gone: `nohup` execs, so $launched IS the server. Waiting a flat five
    # seconds released the lock whether or not the child had ever appeared, which is a
    # release conditioned on the clock rather than on the thing being waited for.
    if ! kill -0 "$launched" 2>/dev/null; then break; fi
    sleep 0.1
done
release_lock


if [ -n "$config_given" ]; then
    # Both halves. A config can move the ROUTE as well as the port, and probing
    # "$port$route" when either came from the file gets a 404 from a perfectly healthy
    # server -- which `curl -f` correctly refuses, so a working launch reports that it
    # never answered. Only the port was warned about before.
    if [ -z "$port_explicit" ]; then
        echo "memworld: --config may set its own port; probing the default $port." >&2
    fi
    if [ "$route" = "/memory_world" ]; then
        echo "memworld: --config may set its own client route; probing $route." >&2
    fi
fi
printf 'memworld: starting on %s' "$(basename "$recording")"
for _ in $(seq 1 120); do
    # Our child, not just the port. The lock is released before this loop, so another
    # `memworld` can legitimately take it, stop this server and bind in its place -- and
    # then THIS launcher's curl gets a 200 from THAT one and prints a success banner
    # naming this recording, with URLs into the other one's world. The wait loop above
    # already asks `kill -0`; the loop that decides success did not.
    if ! kill -0 "$launched" 2>/dev/null; then
        echo
        echo "memworld: the server exited before it answered. Last lines of $log:" >&2
        tail -5 "$log" >&2
        exit 1
    fi
    # -f: without it curl calls a 404 a success, so ANY listener on the port -- an old
    # server, something else entirely -- ends this loop and prints the banner and URLs.
    if curl -fsk -o /dev/null --max-time 2 "https://127.0.0.1:$port$route"; then
        # By path: ipconfig lives in /usr/sbin, and under a stock `PATH=/usr/bin:/bin` this
        # fell back to 127.0.0.1 -- which on the headset means the headset, so the one URL
        # printed FOR another device pointed at itself.
        lan=$(/usr/sbin/ipconfig getifaddr en0 2>/dev/null \
              || ipconfig getifaddr en0 2>/dev/null \
              || echo 127.0.0.1)
        echo
        echo "  this machine  https://127.0.0.1:$port$route?flat"
        echo "  phone / Quest https://$lan:$port$route       (self-signed cert: Advanced -> proceed)"
        echo "  ?flat skips WebXR, log $log, 'memworld --stop' to quit"
        exit 0
    fi
    printf .
    sleep 2
done
echo
echo "memworld: server did not answer in 4 minutes, see $log" >&2
exit 1
