#!/usr/bin/env -S deno run --allow-net=www.googleapis.com,oauth2.googleapis.com,accounts.google.com,127.0.0.1 --allow-read --allow-write --allow-env --allow-run=open

// drive — read-only Google Drive from the terminal, built for agents.
//
// Deliberately does NOT share a token with ~/Commands/gmail: its own config dir
// means it can be authorized to a DIFFERENT Google account (personal or TAMU)
// while the Claude Drive connector stays pointed at jeff@dimensional.org.
// Claude's connector only allows one Google account at a time; this sidesteps it.
//
//   drive auth                                 browser consent, once
//   drive whoami                               which account this token belongs to
//   drive search '<drive query>' [--max N]     one line per file
//   drive find <words...> [--max N]            fuzzy name+body search, no query syntax
//   drive ls [folderId] [--max N]              children of a folder (default: My Drive root)
//   drive shared [--max N]                     everything shared with this account
//   drive read <fileId> [--max N]              text of a Doc/Sheet/Slide/txt, trimmed
//   drive get <fileId> [outPath]               download any file as-is
//
// Google-native files are exported: Docs -> text, Sheets -> csv, Slides -> text.
// Output is compact plain text so LLM sessions can ingest it cheaply.

const HOME = Deno.env.get("HOME")
const CONFIG_DIR = `${HOME}/.config/drive`
const CLIENT_PATH = `${CONFIG_DIR}/client.json`
const TOKEN_PATH = `${CONFIG_DIR}/token.json`
const GMAIL_CLIENT_PATH = `${HOME}/.config/gmail_attachment/client.json`
const SCOPE = "https://www.googleapis.com/auth/drive.readonly"
const API = "https://www.googleapis.com/drive/v3"
const PORT = 8732
const DEFAULT_MAX = 25
const BODY_TRIM = 4000

const EXPORT_AS = {
    "application/vnd.google-apps.document": ["text/plain", "txt"],
    "application/vnd.google-apps.spreadsheet": ["text/csv", "csv"],
    "application/vnd.google-apps.presentation": ["text/plain", "txt"],
    "application/vnd.google-apps.script": ["application/vnd.google-apps.script+json", "json"],
}

function die(message) {
    console.error(message)
    Deno.exit(1)
}

async function readJson(path) {
    try {
        return JSON.parse(await Deno.readTextFile(path))
    } catch (_error) {
        return null
    }
}

async function writeSecret(path, value) {
    await Deno.mkdir(CONFIG_DIR, { recursive: true })
    await Deno.writeTextFile(path, JSON.stringify(value, null, 4))
    await Deno.chmod(path, 0o600)
}

// --- oauth ---------------------------------------------------------------

function base64Url(bytes) {
    return btoa(String.fromCharCode(...bytes)).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "")
}

async function pkcePair() {
    const random = crypto.getRandomValues(new Uint8Array(32))
    const verifier = base64Url(random)
    const digest = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(verifier))
    return { verifier, challenge: base64Url(new Uint8Array(digest)) }
}

function awaitRedirect(port) {
    let resolveCode
    const codePromise = new Promise((resolve) => {
        resolveCode = resolve
    })
    const server = Deno.serve({ port, hostname: "127.0.0.1", onListen: () => {} }, (request) => {
        const params = new URL(request.url).searchParams
        const code = params.get("code")
        const error = params.get("error")
        if (code || error) {
            resolveCode({ code, error })
        }
        return new Response(
            code ? "Authorized. You can close this tab." : `Authorization failed: ${error ?? "no code"}`,
            { headers: { "content-type": "text/plain" } },
        )
    })
    return { codePromise, shutdown: () => server.shutdown() }
}

async function loadClient() {
    let client = await readJson(CLIENT_PATH)
    if (client) {
        return client
    }
    // Fall back to the Gmail desktop client — a desktop OAuth client is not tied
    // to an account, so the same id/secret can authorize a different one.
    client = await readJson(GMAIL_CLIENT_PATH)
    if (client) {
        await writeSecret(CLIENT_PATH, client)
        console.error(`Reused the OAuth client from gmail_attachment (copied to ${CLIENT_PATH}).`)
        return client
    }
    die(
        `No OAuth client. Either authorize gmail first, or:\n` +
            `  drive set-client <CLIENT_ID> <CLIENT_SECRET>\n\n` +
            `To make one: console.cloud.google.com > APIs & Services > Credentials >\n` +
            `Create credentials > OAuth client ID > Desktop app. Enable the Drive API,\n` +
            `and add yourself under Test users on the consent screen.`,
    )
}

async function authorize() {
    const client = await loadClient()
    const redirectUri = `http://127.0.0.1:${PORT}`
    const { verifier, challenge } = await pkcePair()
    const authUrl = new URL("https://accounts.google.com/o/oauth2/v2/auth")
    authUrl.search = new URLSearchParams({
        client_id: client.client_id,
        redirect_uri: redirectUri,
        response_type: "code",
        scope: SCOPE,
        access_type: "offline",
        prompt: "consent select_account",
        code_challenge: challenge,
        code_challenge_method: "S256",
    }).toString()

    const { codePromise, shutdown } = awaitRedirect(PORT)
    console.error(`Opening your browser for read-only Drive access.`)
    console.error(`⚠️  Pick the account that actually holds the folder you want.`)
    console.error(`If it does not open, visit:\n${authUrl}\n`)
    try {
        await new Deno.Command("open", { args: [authUrl.toString()] }).output()
    } catch (_error) {
        // headless or no `open`; the printed URL is the fallback
    }

    const { code, error } = await codePromise
    await shutdown()
    if (!code) {
        die(`Authorization failed: ${error ?? "no code returned"}`)
    }

    const response = await fetch("https://oauth2.googleapis.com/token", {
        method: "POST",
        headers: { "content-type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({
            code,
            client_id: client.client_id,
            client_secret: client.client_secret,
            redirect_uri: redirectUri,
            grant_type: "authorization_code",
            code_verifier: verifier,
        }),
    })
    const token = await response.json()
    if (!response.ok) {
        die(`Token exchange failed: ${JSON.stringify(token)}`)
    }
    token.expires_at = Date.now() + (token.expires_in - 60) * 1000
    await writeSecret(TOKEN_PATH, token)
    console.error("Authorized. Token saved.")
}

async function accessToken() {
    const token = await readJson(TOKEN_PATH)
    if (!token) {
        die(`Not authorized yet. Run: drive auth`)
    }
    if (token.expires_at && Date.now() < token.expires_at) {
        return token.access_token
    }
    if (!token.refresh_token) {
        die("Token expired and no refresh token. Run: drive auth")
    }
    const client = await loadClient()
    const response = await fetch("https://oauth2.googleapis.com/token", {
        method: "POST",
        headers: { "content-type": "application/x-www-form-urlencoded" },
        body: new URLSearchParams({
            client_id: client.client_id,
            client_secret: client.client_secret,
            refresh_token: token.refresh_token,
            grant_type: "refresh_token",
        }),
    })
    const refreshed = await response.json()
    if (!response.ok) {
        die(`Token refresh failed: ${JSON.stringify(refreshed)}. Run: drive auth`)
    }
    const merged = { ...token, ...refreshed }
    merged.expires_at = Date.now() + (refreshed.expires_in - 60) * 1000
    await writeSecret(TOKEN_PATH, merged)
    return merged.access_token
}

async function api(path, searchParams = {}) {
    const url = new URL(`${API}${path}`)
    for (const [key, value] of Object.entries(searchParams)) {
        if (value !== undefined && value !== null) {
            url.searchParams.set(key, String(value))
        }
    }
    const response = await fetch(url, { headers: { authorization: `Bearer ${await accessToken()}` } })
    if (!response.ok) {
        die(`${response.status} ${response.statusText}: ${(await response.text()).slice(0, 400)}`)
    }
    return await response.json()
}

// --- output --------------------------------------------------------------

function shortType(mimeType) {
    if (mimeType === "application/vnd.google-apps.folder") {
        return "folder"
    }
    if (mimeType.startsWith("application/vnd.google-apps.")) {
        return mimeType.slice("application/vnd.google-apps.".length)
    }
    return mimeType
}

function humanSize(bytes) {
    if (!bytes) {
        return "-"
    }
    const units = ["B", "KB", "MB", "GB"]
    let value = Number(bytes)
    let unit = 0
    while (value >= 1024 && unit < units.length - 1) {
        value = value / 1024
        unit = unit + 1
    }
    return `${value < 10 && unit > 0 ? value.toFixed(1) : Math.round(value)}${units[unit]}`
}

function printFiles(files) {
    if (!files || files.length === 0) {
        console.log("(no files)")
        return
    }
    for (const file of files) {
        const owner = file.owners?.[0]?.emailAddress ?? "-"
        const when = (file.modifiedTime ?? "").slice(0, 10)
        console.log(
            `${file.id} | ${shortType(file.mimeType)} | ${when} | ${humanSize(file.size)} | ${owner} | ${file.name}`,
        )
    }
}

const FILE_FIELDS = "files(id,name,mimeType,modifiedTime,size,owners(emailAddress),parents),nextPageToken"

async function listFiles(query, max) {
    const collected = []
    let pageToken
    while (collected.length < max) {
        const page = await api("/files", {
            q: query,
            fields: FILE_FIELDS,
            pageSize: Math.min(100, max - collected.length),
            pageToken,
            orderBy: "modifiedTime desc",
            supportsAllDrives: true,
            includeItemsFromAllDrives: true,
        })
        collected.push(...(page.files ?? []))
        pageToken = page.nextPageToken
        if (!pageToken) {
            break
        }
    }
    return collected.slice(0, max)
}

async function fileText(fileId, max) {
    const meta = await api(`/files/${fileId}`, {
        fields: "id,name,mimeType,size",
        supportsAllDrives: true,
    })
    const exported = EXPORT_AS[meta.mimeType]
    const url = exported
        ? `${API}/files/${fileId}/export?mimeType=${encodeURIComponent(exported[0])}`
        : `${API}/files/${fileId}?alt=media&supportsAllDrives=true`
    const response = await fetch(url, { headers: { authorization: `Bearer ${await accessToken()}` } })
    if (!response.ok) {
        die(`${response.status} reading ${meta.name}: ${(await response.text()).slice(0, 300)}`)
    }
    const text = await response.text()
    console.log(`── ${meta.name} (${shortType(meta.mimeType)}, ${meta.id})`)
    console.log(text.length > max ? `${text.slice(0, max)}\n… trimmed at ${max} chars, --max to raise` : text)
}

async function download(fileId, outPath) {
    const meta = await api(`/files/${fileId}`, {
        fields: "id,name,mimeType",
        supportsAllDrives: true,
    })
    const exported = EXPORT_AS[meta.mimeType]
    const url = exported
        ? `${API}/files/${fileId}/export?mimeType=${encodeURIComponent(exported[0])}`
        : `${API}/files/${fileId}?alt=media&supportsAllDrives=true`
    const response = await fetch(url, { headers: { authorization: `Bearer ${await accessToken()}` } })
    if (!response.ok) {
        die(`${response.status} downloading ${meta.name}: ${(await response.text()).slice(0, 300)}`)
    }
    const target = outPath ?? (exported ? `${meta.name}.${exported[1]}` : meta.name)
    await Deno.writeFile(target, new Uint8Array(await response.arrayBuffer()))
    console.log(target)
}

function quoteForQuery(value) {
    return value.replace(/\\/g, "\\\\").replace(/'/g, "\\'")
}

// --- cli -----------------------------------------------------------------

const args = [...Deno.args]

function takeFlag(name, fallback) {
    const index = args.indexOf(name)
    if (index === -1) {
        return fallback
    }
    const value = args[index + 1]
    args.splice(index, 2)
    return value === undefined ? fallback : Number(value)
}

const max = takeFlag("--max", null)
const command = args.shift()

if (command === "auth") {
    await authorize()
} else if (command === "set-client") {
    const [clientId, clientSecret] = args
    if (!clientId || !clientSecret) {
        die("usage: drive set-client <CLIENT_ID> <CLIENT_SECRET>")
    }
    await writeSecret(CLIENT_PATH, { client_id: clientId, client_secret: clientSecret })
    console.error(`Saved to ${CLIENT_PATH}. Now run: drive auth`)
} else if (command === "whoami") {
    const about = await api("/about", { fields: "user(emailAddress,displayName),storageQuota(usage,limit)" })
    console.log(`${about.user?.emailAddress} (${about.user?.displayName})`)
} else if (command === "search") {
    const query = args.shift()
    if (!query) {
        die(`usage: drive search '<drive query>'   e.g. drive search "name contains 'plume'"`)
    }
    printFiles(await listFiles(query, max ?? DEFAULT_MAX))
} else if (command === "find") {
    if (args.length === 0) {
        die("usage: drive find <words...>")
    }
    const words = args.join(" ")
    const query = `(name contains '${quoteForQuery(words)}' or fullText contains '${quoteForQuery(words)}') and trashed = false`
    printFiles(await listFiles(query, max ?? DEFAULT_MAX))
} else if (command === "ls") {
    const folderId = args.shift() ?? "root"
    printFiles(await listFiles(`'${quoteForQuery(folderId)}' in parents and trashed = false`, max ?? DEFAULT_MAX))
} else if (command === "shared") {
    printFiles(await listFiles("sharedWithMe = true and trashed = false", max ?? DEFAULT_MAX))
} else if (command === "read") {
    const fileId = args.shift()
    if (!fileId) {
        die("usage: drive read <fileId> [--max chars]")
    }
    await fileText(fileId, max ?? BODY_TRIM)
} else if (command === "get") {
    const fileId = args.shift()
    if (!fileId) {
        die("usage: drive get <fileId> [outPath]")
    }
    await download(fileId, args.shift())
} else {
    console.error(
        `drive — read-only Google Drive lookups\n\n` +
            `  drive auth                              authorize (pick the account you want)\n` +
            `  drive whoami                            which account is authorized\n` +
            `  drive find <words...> [--max N]         search names + contents\n` +
            `  drive search '<query>' [--max N]        raw Drive query syntax\n` +
            `  drive ls [folderId] [--max N]           list a folder (default: My Drive)\n` +
            `  drive shared [--max N]                  everything shared with this account\n` +
            `  drive read <fileId> [--max chars]       text of a Doc/Sheet/Slides/txt\n` +
            `  drive get <fileId> [outPath]            download a file\n\n` +
            `Separate token from \`gmail\`, so it can point at a different Google account.\n` +
            `Config: ${CONFIG_DIR}`,
    )
    Deno.exit(args.length === 0 && !command ? 0 : 1)
}
