#!/usr/bin/env -S deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --unstable-ffi

import { Database } from "jsr:@db/sqlite@0.12"

// piping into head/less closes stdout early, which is not an error worth a stack trace
globalThis.addEventListener("unhandledrejection", (event) => {
    if (event.reason instanceof Deno.errors.BrokenPipe) {
        event.preventDefault()
        Deno.exit(0)
    }
})

// --- CLI ---
const args = [...Deno.args]
let dbPath = null
let showEmpty = true
let asJson = false
let colorMode = "auto"
let showTree = true
let treeSeconds = 10
let treeStream = null

for (let i = 0; i < args.length; i++) {
    if (args[i] === "--no-empty") {
        showEmpty = false
    } else if (args[i] === "--json") {
        asJson = true
    } else if (args[i] === "--no-color") {
        colorMode = "never"
    } else if (args[i] === "--color") {
        colorMode = "always"
    } else if (args[i] === "--no-tree") {
        showTree = false
    } else if (args[i] === "--seconds" || args[i] === "-s") {
        treeSeconds = Number(args[++i])
    } else if (args[i] === "--stream") {
        treeStream = args[++i]
    } else if (args[i] === "-h" || args[i] === "--help") {
        console.log(`db_summary — Per-stream counts, rates and gaps, plus the tf frame tree,
             for a dimos memory2 .db recording

Usage: db_summary <recording.db> [--no-empty] [--json] [--color|--no-color]
                                 [--no-tree] [--seconds N] [--stream NAME]

Options:
  --no-empty   Hide streams that have zero messages
  --json       Emit machine-readable JSON instead of a table
  --color      Force color even when piped
  --no-color   Disable color (also honors NO_COLOR)
  --no-tree    Skip the tf frame tree
  --seconds N  Time window for the tf tree, in recording time (default 10)
  --stream NAME  Use a specific stream for the tf tree instead of autodetecting

Columns:
  count   rows in the stream
  dur     span from first to last timestamp
  hz      count / dur
  gap     largest gap between consecutive messages, and how many times
          bigger that is than the stream's own average interval, so 1.0x
          is perfectly even and a big multiple means dropped data

count and hz are shaded on a log scale relative to the largest stream;
gap is shaded by its multiple, independent of the other streams.

Counts rows in each stream's table (no payload decoding), so it works even when
a recording references a renamed/missing payload module.`)
        Deno.exit(0)
    } else if (!dbPath) {
        dbPath = args[i]
    }
}

if (!dbPath) {
    console.error("error: no recording .db given (see --help)")
    Deno.exit(1)
}

const useColor = colorMode === "always" ||
    (colorMode === "auto" && !Deno.env.get("NO_COLOR") && Deno.stdout.isTerminal())

const paint = (text, code) => useColor ? `\x1b[38;5;${code}m${text}\x1b[0m` : text
const dim = (text) => useColor ? `\x1b[2m${text}\x1b[0m` : text
const bold = (text) => useColor ? `\x1b[1m${text}\x1b[0m` : text

const CUBE_STEPS = [0, 95, 135, 175, 215, 255]
const truecolor = /truecolor|24bit/i.test(Deno.env.get("COLORTERM") ?? "")

const hslToRgb = (hue, saturation, lightness) => {
    const chroma = (1 - Math.abs(2 * lightness - 1)) * saturation
    const sector = ((hue % 360) + 360) % 360 / 60
    const second = chroma * (1 - Math.abs(sector % 2 - 1))
    const [r, g, b] = sector < 1
        ? [chroma, second, 0]
        : sector < 2
        ? [second, chroma, 0]
        : sector < 3
        ? [0, chroma, second]
        : sector < 4
        ? [0, second, chroma]
        : sector < 5
        ? [second, 0, chroma]
        : [chroma, 0, second]
    const base = lightness - chroma / 2
    return [r, g, b].map((channel) => Math.round((channel + base) * 255))
}

// blue -> magenta -> red, getting more saturated and brighter as the value climbs,
// so small numbers sit back and big ones pop
const heatRgb = (fraction) => {
    const t = Math.min(1, Math.max(0, fraction))
    return hslToRgb(240 + t * 120, 0.3 + t * 0.65, 0.26 + t * 0.28)
}

const toCube = (value) => CUBE_STEPS.reduce((best, step) => Math.abs(step - value) < Math.abs(best - value) ? step : best)

const bgEscape = ([r, g, b]) => {
    if (truecolor) {
        return `48;2;${r};${g};${b}`
    }
    const index = (channel) => CUBE_STEPS.indexOf(toCube(channel))
    return `48;5;${16 + 36 * index(r) + 6 * index(g) + index(b)}`
}

const paintBg = (text, fraction) => {
    if (!useColor) {
        return text
    }
    const rgb = heatRgb(fraction)
    // dark fills need light text and vice versa
    const foreground = (0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2]) > 150 ? "38;5;16" : "38;5;231"
    return `\x1b[${bgEscape(rgb)};${foreground}m${text}\x1b[0m`
}

// log scale so a 78k stream does not flatten every smaller one to the same color
const logFraction = (value, max) => {
    if (!(value > 0) || !(max > 0)) {
        return 0
    }
    return Math.log10(value + 1) / Math.log10(max + 1)
}

// 1.0x is perfectly even spacing, 20x or worse is saturated red
const gapFraction = (ratio) => Math.log10(Math.max(1, ratio)) / Math.log10(20)

const db = new Database(dbPath, { readonly: true })

// Pull each stream's registered payload module (a string; not imported).
const streams = db.prepare("SELECT name, config FROM _streams ORDER BY name").all()

const rows = []
for (const { name, config } of streams) {
    let payload = ""
    try {
        payload = JSON.parse(config)?.payload_module ?? ""
    } catch (_e) {
        payload = ""
    }
    const count = db.prepare(`SELECT COUNT(*) AS c FROM "${name}"`).get().c
    let lo = null
    let hi = null
    let maxGap = 0
    if (count > 0) {
        const r = db.prepare(`SELECT MIN(ts) AS lo, MAX(ts) AS hi FROM "${name}"`).get()
        lo = r.lo
        hi = r.hi
    }
    if (count > 1) {
        const g = db.prepare(
            `SELECT MAX(ts - prev) AS g FROM (SELECT ts, LAG(ts) OVER (ORDER BY ts) AS prev FROM "${name}")`,
        ).get()
        maxGap = g.g ?? 0
    }
    const dur = (lo !== null && hi !== null) ? (hi - lo) : 0
    const hz = (dur > 0) ? (count / dur) : 0
    // how uneven the worst gap is compared to this stream's own average spacing
    const meanGap = (count > 1 && dur > 0) ? (dur / (count - 1)) : 0
    const gapRatio = (meanGap > 0 && maxGap > 0) ? (maxGap / meanGap) : 0
    rows.push({ name, count, start: lo, end: hi, duration_s: dur, hz, max_gap_s: maxGap, gap_ratio: gapRatio, payload })
}

// --- tf frame tree ---
// One transform per blob, LCM-encoded:
//   fingerprint(8) + transforms_len i32(4) + seq i32(4) + stamp i64(8)
//   then frame_id string, then child_frame_id string (each: i32 length incl null + bytes)
const decodeFrames = (data) => {
    const view = new DataView(data.buffer, data.byteOffset, data.byteLength)
    // empty TFMessages are only 12 bytes: fingerprint(8) + count(4)
    const transformsLength = data.length >= 12 ? view.getInt32(8, false) : 0
    if (transformsLength < 1) {
        return null
    }
    let offset = 24
    const readString = () => {
        const length = view.getInt32(offset, false)
        offset += 4
        const bytes = data.slice(offset, offset + length)
        offset += length
        let end = bytes.length
        while (end > 0 && bytes[end - 1] === 0) {
            end--
        }
        return new TextDecoder().decode(bytes.slice(0, end))
    }
    const parent = readString()
    const child = readString()
    return { parent, child }
}

let treeRows = []
if (showTree && !asJson) {
    if (!treeStream) {
        for (const { name, config } of streams) {
            let type = ""
            try {
                type = JSON.parse(config)?.payload_module?.split(".").pop() ?? ""
            } catch (_e) {
                type = ""
            }
            if (type === "TFMessage" || name === "tf") {
                treeStream = name
                break
            }
        }
    }
    const known = rows.find((r) => r.name === treeStream)
    if (treeStream && known && known.count > 0) {
        treeRows = db.prepare(
            `SELECT b.data AS data FROM "${treeStream}" AS s
             JOIN "${treeStream}_blob" AS b ON b.id = s.id
             WHERE s.ts >= ? AND s.ts <= ?`,
        ).all(known.start, known.start + treeSeconds)
    } else {
        treeStream = null
    }
}

db.close()

const visible = showEmpty ? rows : rows.filter((r) => r.count > 0)

if (asJson) {
    console.log(JSON.stringify(visible, null, 4))
    Deno.exit(0)
}

// --- pretty table ---
const fmtDur = (s) => {
    if (!s || s <= 0) {
        return "-"
    }
    if (s < 60) {
        return `${s.toFixed(1)}s`
    }
    const whole = Math.round(s)
    const m = Math.floor(whole / 60)
    const sec = whole - m * 60
    return `${m}m${String(sec).padStart(2, "0")}s`
}

const fmtGap = (seconds) => {
    if (!(seconds > 0)) {
        return "-"
    }
    if (seconds < 1) {
        return `${(seconds * 1000).toFixed(0)}ms`
    }
    return `${seconds.toFixed(2)}s`
}

const maxCount = Math.max(0, ...visible.map((r) => r.count))
const maxHz = Math.max(0, ...visible.map((r) => r.hz))

const nameW = Math.max(6, ...visible.map((r) => r.name.length))
const gapW = Math.max(9, ...visible.map((r) => `${fmtGap(r.max_gap_s)} ${r.gap_ratio.toFixed(1)}x`.length))
const header = `${"stream".padEnd(nameW)} ${"count".padStart(9)} ${"dur".padStart(8)} ${"hz".padStart(7)} ${"gap".padStart(gapW)}  payload`
console.log(bold(header))
console.log(dim("-".repeat(header.length)))

let total = 0
for (const r of visible) {
    total += r.count
    const hzStr = r.hz > 0 ? r.hz.toFixed(1) : "-"
    const gapStr = r.max_gap_s > 0 ? `${fmtGap(r.max_gap_s)} ${r.gap_ratio.toFixed(1)}x` : "-"
    // keep the tail of the payload module, the long dimos.msgs prefix is noise
    const shortPayload = r.payload.split(".").slice(-2).join(".")
    const countCell = r.count > 0
        ? paintBg(String(r.count).padStart(9), logFraction(r.count, maxCount))
        : String(r.count).padStart(9)
    const hzCell = r.hz > 0 ? paintBg(hzStr.padStart(7), logFraction(r.hz, maxHz)) : hzStr.padStart(7)
    const gapCell = r.gap_ratio > 0 ? paintBg(gapStr.padStart(gapW), gapFraction(r.gap_ratio)) : gapStr.padStart(gapW)
    console.log(
        `${r.name.padEnd(nameW)} ${countCell} ${fmtDur(r.duration_s).padStart(8)} ${hzCell} ${gapCell}  ${dim(shortPayload)}`,
    )
}

console.log(dim("-".repeat(header.length)))
const nonEmpty = rows.filter((r) => r.count > 0).length
console.log(`${rows.length} streams (${nonEmpty} non-empty), ${total} total messages`)

if (!showTree) {
    Deno.exit(0)
}

console.log()
if (!treeStream) {
    console.log(dim("no tf stream found, skipping frame tree"))
    Deno.exit(0)
}

const childrenOf = new Map()
const parentsOf = new Map()
const allFrames = new Set()
const childFrames = new Set()
for (const row of treeRows) {
    const frames = decodeFrames(row.data)
    if (!frames) {
        continue
    }
    if (!childrenOf.has(frames.parent)) {
        childrenOf.set(frames.parent, new Set())
    }
    childrenOf.get(frames.parent).add(frames.child)
    if (!parentsOf.has(frames.child)) {
        parentsOf.set(frames.child, new Map())
    }
    const seen = parentsOf.get(frames.child)
    seen.set(frames.parent, (seen.get(frames.parent) ?? 0) + 1)
    allFrames.add(frames.parent)
    allFrames.add(frames.child)
    childFrames.add(frames.child)
}

// a frame with two parents means two publishers are fighting over it, which tf does not allow
const conflicted = [...parentsOf.entries()].filter(([_frame, seen]) => seen.size > 1)

console.log(bold(`tf frames`) + dim(`  (${treeStream}, first ${treeSeconds}s, ${treeRows.length} msgs)`))

const roots = [...allFrames].filter((frame) => !childFrames.has(frame)).sort()
if (roots.length === 0) {
    console.log(dim("(no tf frames found in this window)"))
    Deno.exit(0)
}

const renderChild = (frame, prefix, isLast, onPath) => {
    const cycle = onPath.has(frame)
    const multiParent = (parentsOf.get(frame)?.size ?? 0) > 1
    const note = cycle
        ? paint("  (cycle)", 196)
        : multiParent
        ? paint(`  (${parentsOf.get(frame).size} parents)`, 208)
        : ""
    console.log(`${dim(prefix + (isLast ? "└── " : "├── "))}${frame}${note}`)
    if (cycle) {
        return
    }
    const nextOnPath = new Set(onPath).add(frame)
    const kids = [...(childrenOf.get(frame) ?? [])].sort()
    const childPrefix = prefix + (isLast ? "    " : "│   ")
    kids.forEach((kid, index) => {
        renderChild(kid, childPrefix, index === kids.length - 1, nextOnPath)
    })
}

for (const root of roots) {
    console.log(bold(paint(root, 51)))
    const kids = [...(childrenOf.get(root) ?? [])].sort()
    kids.forEach((kid, index) => {
        renderChild(kid, "", index === kids.length - 1, new Set([root]))
    })
}

if (conflicted.length > 0) {
    console.log()
    console.log(paint(`${conflicted.length} frame(s) with more than one parent — tf requires exactly one:`, 208))
    for (const [frame, seen] of conflicted) {
        const byCount = [...seen.entries()].sort((a, b) => b[1] - a[1])
        console.log(`  ${frame}  <-  ${byCount.map(([parent, n]) => `${parent} (${n})`).join("  |  ")}`)
    }
    if (roots.length > 1) {
        console.log(dim(`  this is also why there are ${roots.length} roots: ${roots.join(", ")}`))
    }
}
