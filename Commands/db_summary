#!/usr/bin/env -S deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi --unstable-ffi

import { Database } from "jsr:@db/sqlite@0.12"
import { McapIndexedReader } from "https://esm.sh/@mcap/core@2.1.7"
import { decompress as zstdDecompress } from "https://esm.sh/fzstd@0.1.1"
import lz4 from "https://esm.sh/lz4js@0.2.0"

// piping into head/less closes stdout early, which is not an error worth a stack trace
globalThis.addEventListener("unhandledrejection", (event) => {
    if (event.reason instanceof Deno.errors.BrokenPipe) {
        event.preventDefault()
        Deno.exit(0)
    }
})

// --- CLI ---
const args = [...Deno.args]
let dbPath = null
let showEmpty = true
let asJson = false
let colorMode = "auto"
let showTree = true
let treeSeconds = 10
let treeStream = null
let htmlPath = undefined

for (let i = 0; i < args.length; i++) {
    if (args[i] === "--no-empty") {
        showEmpty = false
    } else if (args[i] === "--json") {
        asJson = true
    } else if (args[i] === "--no-color") {
        colorMode = "never"
    } else if (args[i] === "--color") {
        colorMode = "always"
    } else if (args[i] === "--no-tree") {
        showTree = false
    } else if (args[i] === "--seconds" || args[i] === "-s") {
        treeSeconds = Number(args[++i])
    } else if (args[i] === "--stream") {
        treeStream = args[++i]
    } else if (args[i] === "--html") {
        // an optional path: "--html out.html" writes a file, a bare "--html" writes to stdout
        htmlPath = (args[i + 1] && !args[i + 1].startsWith("-")) ? args[++i] : null
    } else if (args[i] === "-h" || args[i] === "--help") {
        console.log(`db_summary — Per-stream counts, rates and gaps, plus the tf frame tree,
             for a dimos memory2 .db recording, or a ROS 2 / LCM .mcap

Usage: db_summary <recording.db|recording.mcap> [--no-empty] [--json] [--html [FILE]]
                                 [--color|--no-color] [--no-tree] [--seconds N] [--stream NAME]

Options:
  --no-empty   Hide streams that have zero messages
  --json       Emit machine-readable JSON instead of a table
  --html FILE  Write the same colored output as a standalone HTML page,
               to FILE, or to stdout when no path follows
  --color      Force color even when piped
  --no-color   Disable color (also honors NO_COLOR)
  --no-tree    Skip the tf frame tree
  --seconds N  Time window for the tf tree, in recording time (default 10)
  --stream NAME  Use a specific stream for the tf tree instead of autodetecting

Columns:
  count   rows in the stream
  dur     span from first to last timestamp
  hz      count / dur
  p99     99th percentile gap between consecutive messages, so a stream
          that stutters routinely reads high while one that hiccupped
          once stays low — read it next to gap to tell those apart
  gap     largest gap between consecutive messages, and how many times
          bigger that is than the stream's own average interval, so 1.0x
          is perfectly even and a big multiple means dropped data

count and hz are shaded on a log scale relative to the largest stream;
p99 and gap are shaded by their multiple of the stream's own average
interval, independent of the other streams.

Counts rows in each stream's table (no payload decoding), so it works even when
a recording references a renamed/missing payload module. For an .mcap the streams
are its channels (leading slash dropped), payload is the schema name, and the
timestamps are log times.`)
        Deno.exit(0)
    } else if (!dbPath) {
        dbPath = args[i]
    }
}

if (!dbPath) {
    console.error("error: no recording .db given (see --help)")
    Deno.exit(1)
}

const asHtml = htmlPath !== undefined
if (asHtml && asJson) {
    console.error("error: --html and --json are two different outputs; pick one")
    Deno.exit(1)
}

// The page IS the terminal output, so it is drawn with color on whatever the tty says.
const useColor = asHtml || colorMode === "always" ||
    (colorMode === "auto" && !Deno.env.get("NO_COLOR") && Deno.stdout.isTerminal())

// --- HTML ---
// The table is written once, in ANSI, and turned into a page at the end: the
// alternative is a second set of print statements that drifts from the first.
const captured = []
if (asHtml) {
    const log = console.log
    console.log = (...parts) => captured.push(parts.join(" "))
    globalThis.addEventListener("unload", () => {
        const page = ansiPage(captured.join("\n"), `${dbPath} — db_summary`)
        if (htmlPath) {
            Deno.writeTextFileSync(htmlPath, page)
            // stderr, so "--html out.html" still pipes nothing but the page
            console.error(`wrote ${htmlPath}`)
        } else {
            log(page)
        }
    })
}

const xterm256 = () => {
    const basic = [
        "#000000", "#cd0000", "#00cd00", "#cdcd00", "#0000ee", "#cd00cd", "#00cdcd", "#e5e5e5",
        "#7f7f7f", "#ff0000", "#00ff00", "#ffff00", "#5c5cff", "#ff00ff", "#00ffff", "#ffffff",
    ]
    const hex = (value) => value.toString(16).padStart(2, "0")
    const out = [...basic]
    for (const r of CUBE_STEPS) {
        for (const g of CUBE_STEPS) {
            for (const b of CUBE_STEPS) {
                out.push(`#${hex(r)}${hex(g)}${hex(b)}`)
            }
        }
    }
    for (let i = 0; i < 24; i++) {
        const grey = 8 + i * 10
        out.push(`#${hex(grey)}${hex(grey)}${hex(grey)}`)
    }
    return out
}

const escapeHtml = (text) => text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;")

// SGR runs -> spans. Only the codes this script emits are handled, plus the
// plain 30-37/40-47 ones, so a future paint() cannot silently lose its color.
const ansiToHtml = (raw) => {
    const palette = xterm256()
    const blank = { fg: null, bg: null, bold: false, dim: false, underline: false }
    let state = { ...blank }
    const pieces = []
    let plain = ""

    const flush = () => {
        if (plain === "") {
            return
        }
        const style = []
        if (state.fg !== null) {
            style.push(`color:${state.fg}`)
        }
        if (state.bg !== null) {
            style.push(`background:${state.bg}`)
        }
        if (state.bold) {
            style.push("font-weight:700")
        }
        if (state.dim) {
            style.push("opacity:.62")
        }
        if (state.underline) {
            style.push("text-decoration:underline")
        }
        pieces.push(style.length ? `<span style="${style.join(";")}">${escapeHtml(plain)}</span>` : escapeHtml(plain))
        plain = ""
    }

    const apply = (codes) => {
        for (let i = 0; i < codes.length; i++) {
            const code = codes[i]
            const extended = (code === 38 || code === 48)
            if (extended && codes[i + 1] === 2) {
                const color = `rgb(${codes[i + 2]},${codes[i + 3]},${codes[i + 4]})`
                if (code === 38) {
                    state.fg = color
                } else {
                    state.bg = color
                }
                i += 4
            } else if (extended && codes[i + 1] === 5) {
                const color = palette[codes[i + 2]] ?? null
                if (code === 38) {
                    state.fg = color
                } else {
                    state.bg = color
                }
                i += 2
            } else if (code === 0) {
                state = { ...blank }
            } else if (code === 1) {
                state.bold = true
            } else if (code === 2) {
                state.dim = true
            } else if (code === 4) {
                state.underline = true
            } else if (code === 22) {
                state.bold = false
                state.dim = false
            } else if (code === 24) {
                state.underline = false
            } else if (code === 39) {
                state.fg = null
            } else if (code === 49) {
                state.bg = null
            } else if (code >= 30 && code <= 37) {
                state.fg = palette[code - 30]
            } else if (code >= 90 && code <= 97) {
                state.fg = palette[code - 82]
            } else if (code >= 40 && code <= 47) {
                state.bg = palette[code - 40]
            } else if (code >= 100 && code <= 107) {
                state.bg = palette[code - 92]
            }
        }
    }

    const sgr = /\x1b\[([0-9;]*)m/g
    let cursor = 0
    let match
    while ((match = sgr.exec(raw)) !== null) {
        plain += raw.slice(cursor, match.index)
        flush()
        apply(match[1].split(";").filter((part) => part !== "").map(Number))
        cursor = sgr.lastIndex
    }
    plain += raw.slice(cursor)
    flush()
    return pieces.join("")
}

// A standalone file: no charset meta and the em-dashes and box-drawing
// characters in the tf tree come out as mojibake.
const ansiPage = (raw, title) => `<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>${escapeHtml(title)}</title>
<style>
:root { --page: #f6f6f4; --ink: #1b1b1f; --muted: #6b6b76; --term-bg: #11121a; --term-ink: #e6e6ec; --edge: #dededa; color-scheme: light }
@media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) { --page: #0f1014; --ink: #e9e9ee; --muted: #9a9aa6; --term-bg: #0a0b10; --edge: #26272f; color-scheme: dark }
}
:root[data-theme="dark"] { --page: #0f1014; --ink: #e9e9ee; --muted: #9a9aa6; --term-bg: #0a0b10; --edge: #26272f; color-scheme: dark }
body { background: var(--page); color: var(--ink); font: 14px/1.5 ui-sans-serif, -apple-system, "Segoe UI", sans-serif; margin: 0; padding: 28px 20px 48px }
main { max-width: 1180px; margin: 0 auto }
h1 { font-size: 17px; font-weight: 650; letter-spacing: -0.01em; margin: 0 0 4px }
p.sub { color: var(--muted); margin: 0 0 20px; font-size: 13px }
.term { background: var(--term-bg); border: 1px solid var(--edge); border-radius: 10px; padding: 18px 20px; overflow-x: auto }
pre { margin: 0; color: var(--term-ink); font: 12.5px/1.45 ui-monospace, "SF Mono", Menlo, Consolas, monospace; white-space: pre }
</style>
<main>
<h1>${escapeHtml(title)}</h1>
<p class="sub">db_summary output, colors preserved</p>
<div class="term"><pre>${ansiToHtml(raw)}</pre></div>
</main>
`

const paint = (text, code) => useColor ? `\x1b[38;5;${code}m${text}\x1b[0m` : text
const dim = (text) => useColor ? `\x1b[2m${text}\x1b[0m` : text
const bold = (text) => useColor ? `\x1b[1m${text}\x1b[0m` : text

const CUBE_STEPS = [0, 95, 135, 175, 215, 255]
let truecolor = /truecolor|24bit/i.test(Deno.env.get("COLORTERM") ?? "")
if (asHtml) {
    truecolor = true
}

const hslToRgb = (hue, saturation, lightness) => {
    const chroma = (1 - Math.abs(2 * lightness - 1)) * saturation
    const sector = ((hue % 360) + 360) % 360 / 60
    const second = chroma * (1 - Math.abs(sector % 2 - 1))
    const [r, g, b] = sector < 1
        ? [chroma, second, 0]
        : sector < 2
        ? [second, chroma, 0]
        : sector < 3
        ? [0, chroma, second]
        : sector < 4
        ? [0, second, chroma]
        : sector < 5
        ? [second, 0, chroma]
        : [chroma, 0, second]
    const base = lightness - chroma / 2
    return [r, g, b].map((channel) => Math.round((channel + base) * 255))
}

// blue -> magenta -> red, getting more saturated and brighter as the value climbs,
// so small numbers sit back and big ones pop
const heatRgb = (fraction) => {
    const t = Math.min(1, Math.max(0, fraction))
    return hslToRgb(240 + t * 120, 0.3 + t * 0.65, 0.26 + t * 0.28)
}

const toCube = (value) => CUBE_STEPS.reduce((best, step) => Math.abs(step - value) < Math.abs(best - value) ? step : best)

const bgEscape = ([r, g, b]) => {
    if (truecolor) {
        return `48;2;${r};${g};${b}`
    }
    const index = (channel) => CUBE_STEPS.indexOf(toCube(channel))
    return `48;5;${16 + 36 * index(r) + 6 * index(g) + index(b)}`
}

const paintBg = (text, fraction) => {
    if (!useColor) {
        return text
    }
    const rgb = heatRgb(fraction)
    // dark fills need light text and vice versa
    const foreground = (0.299 * rgb[0] + 0.587 * rgb[1] + 0.114 * rgb[2]) > 150 ? "38;5;16" : "38;5;231"
    return `\x1b[${bgEscape(rgb)};${foreground}m${text}\x1b[0m`
}

// log scale so a 78k stream does not flatten every smaller one to the same color
const logFraction = (value, max) => {
    if (!(value > 0) || !(max > 0)) {
        return 0
    }
    return Math.log10(value + 1) / Math.log10(max + 1)
}

// 1.0x is perfectly even spacing, 20x or worse is saturated red
const gapFraction = (ratio) => Math.log10(Math.max(1, ratio)) / Math.log10(20)

const isMcap = dbPath.toLowerCase().endsWith(".mcap")

// Both sources produce the same rows; the tf tree needs a way to fetch the first
// few seconds of a TFMessage stream and a decoder for its bytes.
const rows = []
let db = null
let mcap = null
let mcapFile = null

const summarise = (name, payload, count, times) => {
    // times: ascending seconds; only needed when count > 1
    let lo = null
    let hi = null
    let maxGap = 0
    let p99Gap = 0
    if (count > 0 && times.length > 0) {
        lo = times[0]
        hi = times[times.length - 1]
    }
    if (times.length > 1) {
        const gaps = new Float64Array(times.length - 1)
        for (let i = 1; i < times.length; i++) {
            gaps[i - 1] = times[i] - times[i - 1]
        }
        gaps.sort()
        maxGap = gaps[gaps.length - 1]
        const index = Math.min(gaps.length - 1, Math.max(0, Math.ceil(gaps.length * 0.99) - 1))
        p99Gap = gaps[index]
    }
    const dur = (lo !== null && hi !== null) ? (hi - lo) : 0
    const hz = (dur > 0) ? (count / dur) : 0
    const meanGap = (count > 1 && dur > 0) ? (dur / (count - 1)) : 0
    const gapRatio = (meanGap > 0 && maxGap > 0) ? (maxGap / meanGap) : 0
    const p99Ratio = (meanGap > 0 && p99Gap > 0) ? (p99Gap / meanGap) : 0
    return {
        name,
        count,
        start: lo,
        end: hi,
        duration_s: dur,
        hz,
        p99_gap_s: p99Gap,
        p99_ratio: p99Ratio,
        max_gap_s: maxGap,
        gap_ratio: gapRatio,
        payload,
    }
}

let streams = []
if (isMcap) {
    mcapFile = await Deno.open(dbPath, { read: true })
    const size = (await mcapFile.stat()).size
    const readable = {
        size: async () => BigInt(size),
        read: async (offset, length) => {
            const buffer = new Uint8Array(Number(length))
            await mcapFile.seek(Number(offset), Deno.SeekMode.Start)
            let filled = 0
            while (filled < buffer.length) {
                const read = await mcapFile.read(buffer.subarray(filled))
                if (read === null) {
                    break
                }
                filled += read
            }
            return buffer
        },
    }
    const decompressHandlers = {
        zstd: (bytes, size) => zstdDecompress(bytes, new Uint8Array(Number(size))),
        lz4: (bytes) => new Uint8Array(lz4.decompress(bytes)),
    }
    mcap = await McapIndexedReader.Initialize({ readable, decompressHandlers })
    const channels = [...mcap.channelsById.values()].sort((a, b) => a.topic.localeCompare(b.topic))
    // One pass over the whole file: every chunk is decompressed exactly once and
    // only the log times are kept, so a 60 GB recording costs one sequential read.
    const timesById = new Map(channels.map((channel) => [channel.id, []]))
    for await (const message of mcap.readMessages()) {
        timesById.get(message.channelId)?.push(Number(message.logTime) / 1e9)
    }
    for (const channel of channels) {
        const name = channel.topic.replace(/^\//, "")
        const schema = mcap.schemasById.get(channel.schemaId)
        const payload = schema ? `${schema.name} (${channel.messageEncoding})` : channel.messageEncoding
        const times = timesById.get(channel.id)
        times.sort((a, b) => a - b)
        const count = Number(mcap.statistics?.channelMessageCounts.get(channel.id) ?? times.length)
        rows.push(summarise(name, payload, count, times))
        streams.push({ name, config: JSON.stringify({ payload_module: schema?.name ?? "" }), channel })
    }
} else {
    db = new Database(dbPath, { readonly: true })
    // Pull each stream's registered payload module (a string; not imported).
    streams = db.prepare("SELECT name, config FROM _streams ORDER BY name").all()
    for (const { name, config } of streams) {
        let payload = ""
        try {
            payload = JSON.parse(config)?.payload_module ?? ""
        } catch (_e) {
            payload = ""
        }
        const count = db.prepare(`SELECT COUNT(*) AS c FROM "${name}"`).get().c
        const times = count > 0
            ? db.prepare(`SELECT ts FROM "${name}" ORDER BY ts`).all().map((r) => r.ts)
            : []
        rows.push(summarise(name, payload, count, times))
    }
}

// --- tf frame tree ---
// One transform per blob, LCM-encoded:
//   fingerprint(8) + transforms_len i32(4) + seq i32(4) + stamp i64(8)
//   then frame_id string, then child_frame_id string (each: i32 length incl null + bytes)
const decodeFrames = (data) => {
    const view = new DataView(data.buffer, data.byteOffset, data.byteLength)
    // empty TFMessages are only 12 bytes: fingerprint(8) + count(4)
    const transformsLength = data.length >= 12 ? view.getInt32(8, false) : 0
    if (transformsLength < 1) {
        return null
    }
    let offset = 24
    const readString = () => {
        const length = view.getInt32(offset, false)
        offset += 4
        const bytes = data.slice(offset, offset + length)
        offset += length
        let end = bytes.length
        while (end > 0 && bytes[end - 1] === 0) {
            end--
        }
        return new TextDecoder().decode(bytes.slice(0, end))
    }
    const parent = readString()
    const child = readString()
    return { parent, child }
}

// ROS 2 CDR TFMessage: 4-byte encapsulation, then a sequence of TransformStamped
// (header{stamp sec/nanosec, frame_id}, child_frame_id, translation, rotation).
// Alignment is measured from the body start; only the frame names are read.
const decodeCdrFrames = (data) => {
    const view = new DataView(data.buffer, data.byteOffset, data.byteLength)
    const little = (view.getUint8(1) & 1) === 1
    let at = 4
    const align = (width) => {
        at += (width - ((at - 4) % width)) % width
    }
    const uint32 = () => {
        align(4)
        const value = view.getUint32(at, little)
        at += 4
        return value
    }
    const string = () => {
        const length = uint32()
        const bytes = new Uint8Array(view.buffer, view.byteOffset + at, Math.max(0, length - 1))
        at += length
        return new TextDecoder().decode(bytes)
    }
    const edges = []
    for (let i = uint32(); i > 0; i--) {
        uint32() // stamp.sec
        uint32() // stamp.nanosec
        const parent = string()
        const child = string()
        align(8)
        at += 7 * 8 // translation xyz + rotation xyzw
        edges.push({ parent, child })
    }
    return edges
}

let treeRows = []
let treeDecode = (data) => {
    const frames = decodeFrames(data)
    return frames ? [frames] : []
}
if (showTree && !asJson) {
    if (!treeStream) {
        for (const { name, config } of streams) {
            let type = ""
            try {
                type = JSON.parse(config)?.payload_module?.split(/[./]/).pop() ?? ""
            } catch (_e) {
                type = ""
            }
            if (type === "TFMessage" || name === "tf" || name === "tf_static") {
                treeStream = name
                break
            }
        }
    }
    const known = rows.find((r) => r.name === treeStream)
    if (treeStream && known && known.count > 0) {
        if (isMcap) {
            const { channel } = streams.find((s) => s.name === treeStream)
            const endNs = BigInt(Math.round((known.start + treeSeconds) * 1e9))
            for await (const message of mcap.readMessages({ topics: [channel.topic], endTime: endNs })) {
                treeRows.push({ data: message.data })
            }
            if (channel.messageEncoding === "cdr") {
                treeDecode = decodeCdrFrames
            }
        } else {
            treeRows = db.prepare(
                `SELECT b.data AS data FROM "${treeStream}" AS s
                 JOIN "${treeStream}_blob" AS b ON b.id = s.id
                 WHERE s.ts >= ? AND s.ts <= ?`,
            ).all(known.start, known.start + treeSeconds)
        }
    } else {
        treeStream = null
    }
}

if (db) {
    db.close()
}
if (mcapFile) {
    mcapFile.close()
}

const visible = showEmpty ? rows : rows.filter((r) => r.count > 0)

if (asJson) {
    console.log(JSON.stringify(visible, null, 4))
    Deno.exit(0)
}

// --- pretty table ---
const fmtDur = (s) => {
    if (!s || s <= 0) {
        return "-"
    }
    if (s < 60) {
        return `${s.toFixed(1)}s`
    }
    const whole = Math.round(s)
    const m = Math.floor(whole / 60)
    const sec = whole - m * 60
    return `${m}m${String(sec).padStart(2, "0")}s`
}

const fmtGap = (seconds) => {
    if (!(seconds > 0)) {
        return "-"
    }
    if (seconds < 1) {
        return `${(seconds * 1000).toFixed(0)}ms`
    }
    return `${seconds.toFixed(2)}s`
}

const maxCount = Math.max(0, ...visible.map((r) => r.count))
const maxHz = Math.max(0, ...visible.map((r) => r.hz))

const nameW = Math.max(6, ...visible.map((r) => r.name.length))
const p99W = Math.max(7, ...visible.map((r) => fmtGap(r.p99_gap_s).length))
const gapW = Math.max(9, ...visible.map((r) => `${fmtGap(r.max_gap_s)} ${r.gap_ratio.toFixed(1)}x`.length))
const header = `${"stream".padEnd(nameW)} ${"count".padStart(9)} ${"dur".padStart(8)} ${"hz".padStart(7)} ${"p99".padStart(p99W)} ${"gap".padStart(gapW)}  payload`
console.log(bold(header))
console.log(dim("-".repeat(header.length)))

let total = 0
for (const r of visible) {
    total += r.count
    const hzStr = r.hz > 0 ? r.hz.toFixed(1) : "-"
    const gapStr = r.max_gap_s > 0 ? `${fmtGap(r.max_gap_s)} ${r.gap_ratio.toFixed(1)}x` : "-"
    // keep the tail of the payload module, the long dimos.msgs prefix is noise
    const shortPayload = r.payload.includes("/") ? r.payload : r.payload.split(".").slice(-2).join(".")
    const countCell = r.count > 0
        ? paintBg(String(r.count).padStart(9), logFraction(r.count, maxCount))
        : String(r.count).padStart(9)
    const hzCell = r.hz > 0 ? paintBg(hzStr.padStart(7), logFraction(r.hz, maxHz)) : hzStr.padStart(7)
    const p99Str = fmtGap(r.p99_gap_s)
    const p99Cell = r.p99_ratio > 0
        ? paintBg(p99Str.padStart(p99W), gapFraction(r.p99_ratio))
        : p99Str.padStart(p99W)
    const gapCell = r.gap_ratio > 0 ? paintBg(gapStr.padStart(gapW), gapFraction(r.gap_ratio)) : gapStr.padStart(gapW)
    console.log(
        `${r.name.padEnd(nameW)} ${countCell} ${
            fmtDur(r.duration_s).padStart(8)
        } ${hzCell} ${p99Cell} ${gapCell}  ${dim(shortPayload)}`,
    )
}

console.log(dim("-".repeat(header.length)))
const nonEmpty = rows.filter((r) => r.count > 0).length
console.log(`${rows.length} streams (${nonEmpty} non-empty), ${total} total messages`)

if (!showTree) {
    Deno.exit(0)
}

console.log()
if (!treeStream) {
    console.log(dim("no tf stream found, skipping frame tree"))
    Deno.exit(0)
}

const childrenOf = new Map()
const parentsOf = new Map()
const allFrames = new Set()
const childFrames = new Set()
for (const row of treeRows) {
    for (const frames of treeDecode(row.data)) {
    if (!childrenOf.has(frames.parent)) {
        childrenOf.set(frames.parent, new Set())
    }
    childrenOf.get(frames.parent).add(frames.child)
    if (!parentsOf.has(frames.child)) {
        parentsOf.set(frames.child, new Map())
    }
    const seen = parentsOf.get(frames.child)
    seen.set(frames.parent, (seen.get(frames.parent) ?? 0) + 1)
    allFrames.add(frames.parent)
    allFrames.add(frames.child)
    childFrames.add(frames.child)
    }
}

// a frame with two parents means two publishers are fighting over it, which tf does not allow
const conflicted = [...parentsOf.entries()].filter(([_frame, seen]) => seen.size > 1)

console.log(bold(`tf frames`) + dim(`  (${treeStream}, first ${treeSeconds}s, ${treeRows.length} msgs)`))

const roots = [...allFrames].filter((frame) => !childFrames.has(frame)).sort()
if (roots.length === 0) {
    console.log(dim("(no tf frames found in this window)"))
    Deno.exit(0)
}

const renderChild = (frame, prefix, isLast, onPath) => {
    const cycle = onPath.has(frame)
    const multiParent = (parentsOf.get(frame)?.size ?? 0) > 1
    const note = cycle
        ? paint("  (cycle)", 196)
        : multiParent
        ? paint(`  (${parentsOf.get(frame).size} parents)`, 208)
        : ""
    console.log(`${dim(prefix + (isLast ? "└── " : "├── "))}${frame}${note}`)
    if (cycle) {
        return
    }
    const nextOnPath = new Set(onPath).add(frame)
    const kids = [...(childrenOf.get(frame) ?? [])].sort()
    const childPrefix = prefix + (isLast ? "    " : "│   ")
    kids.forEach((kid, index) => {
        renderChild(kid, childPrefix, index === kids.length - 1, nextOnPath)
    })
}

for (const root of roots) {
    console.log(bold(paint(root, 51)))
    const kids = [...(childrenOf.get(root) ?? [])].sort()
    kids.forEach((kid, index) => {
        renderChild(kid, "", index === kids.length - 1, new Set([root]))
    })
}

if (conflicted.length > 0) {
    console.log()
    console.log(paint(`${conflicted.length} frame(s) with more than one parent — tf requires exactly one:`, 208))
    for (const [frame, seen] of conflicted) {
        const byCount = [...seen.entries()].sort((a, b) => b[1] - a[1])
        console.log(`  ${frame}  <-  ${byCount.map(([parent, n]) => `${parent} (${n})`).join("  |  ")}`)
    }
    if (roots.length > 1) {
        console.log(dim(`  this is also why there are ${roots.length} roots: ${roots.join(", ")}`))
    }
}
