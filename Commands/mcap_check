#!/bin/sh
# This lives in dtk now: https://github.com/jeff-hykin/dtk -> tools/
# Kept here so the old name still works; it is the same program either way.
#
#   dtk mcap_check --help
if command -v dtk >/dev/null 2>&1
then
    exec dtk mcap_check "$@"
fi
if [ -x "$HOME/.deno/bin/dtk" ]
then
    exec "$HOME/.deno/bin/dtk" mcap_check "$@"
fi
echo "mcap_check: dtk is not installed. Install it with:" >&2
echo "  curl -fsSL https://raw.githubusercontent.com/jeff-hykin/dtk/master/install.sh | sh" >&2
exit 127
